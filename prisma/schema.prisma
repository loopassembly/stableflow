generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PayoutPolicyType {
  PERCENTAGE_SPLIT
  FIXED_AMOUNT
  THRESHOLD_RELEASE
  AGENTIC_REVENUE_SHARE
}

enum PayoutRunStatus {
  DRAFT
  READY
  EXECUTING
  SETTLED
  PARTIAL
  FAILED
  SIMULATED
}

enum TransferStatus {
  QUEUED
  SENT
  CONFIRMED
  FAILED
  SIMULATED
}

enum SolanaNetwork {
  DEVNET
  MAINNET_BETA
}

enum OrganizationRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id        String   @id
  email     String   @unique
  fullName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  dodoProductId String?
  treasuryWallet String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checkoutSessions DodoCheckoutSession[]
  payments         Payment[]
  recipients       Recipient[]
  payoutPolicies   PayoutPolicy[]
  payoutRuns       PayoutRun[]
  auditLogs        AuditLog[]
  members          OrganizationMember[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(OWNER)
  isDefault      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model DodoCheckoutSession {
  id             String        @id @default(cuid())
  organizationId String
  dodoSessionId  String        @unique
  checkoutUrl    String
  productId      String
  quantity       Int           @default(1)
  amountCents    Int?
  currency       String        @default("USD")
  customerEmail  String?
  customerName   String?
  status         PaymentStatus @default(INITIATED)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment?

  @@index([organizationId])
  @@index([status])
}

model DodoWebhookEvent {
  id          String             @id @default(cuid())
  webhookId   String             @unique
  type        String
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  error       String?
  processedAt DateTime?
  createdAt   DateTime           @default(now())

  payment Payment?

  @@index([type])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  organizationId    String
  checkoutSessionId String?       @unique
  webhookEventId    String?       @unique
  dodoPaymentId     String?       @unique
  amountCents       Int
  currency          String        @default("USD")
  status            PaymentStatus @default(INITIATED)
  customerEmail     String?
  customerName      String?
  rawPayload        Json          @default("{}")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkoutSession DodoCheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  webhookEvent    DodoWebhookEvent?    @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)
  payoutRuns      PayoutRun[]

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model Recipient {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  role           String
  email          String?
  walletAddress  String
  region         String
  kycStatus      String   @default("demo")
  tags           String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payoutRules  PayoutRule[]
  transfers    PayoutTransfer[]

  @@index([organizationId])
  @@index([walletAddress])
}

model PayoutPolicy {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  type           PayoutPolicyType @default(PERCENTAGE_SPLIT)
  triggerType    String           @default("payment.succeeded")
  reserveBps     Int              @default(1000)
  enabled        Boolean          @default(true)
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules        PayoutRule[]
  payoutRuns   PayoutRun[]

  @@index([organizationId])
  @@index([enabled])
}

model PayoutRule {
  id               String   @id @default(cuid())
  payoutPolicyId   String
  recipientId      String
  label            String
  basisPoints      Int      @default(0)
  fixedAmountCents Int?
  priority         Int      @default(0)
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payoutPolicy PayoutPolicy @relation(fields: [payoutPolicyId], references: [id], onDelete: Cascade)
  recipient    Recipient    @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([payoutPolicyId])
  @@index([recipientId])
}

model PayoutRun {
  id                String          @id @default(cuid())
  organizationId    String
  paymentId         String?
  payoutPolicyId    String
  status            PayoutRunStatus @default(DRAFT)
  grossAmountCents  Int
  reserveAmountCents Int            @default(0)
  payoutAmountCents Int
  currency          String          @default("USD")
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payoutPolicy PayoutPolicy     @relation(fields: [payoutPolicyId], references: [id], onDelete: Restrict)
  transfers    PayoutTransfer[]

  @@index([organizationId])
  @@index([paymentId])
  @@index([status])
}

model PayoutTransfer {
  id           String         @id @default(cuid())
  payoutRunId  String
  recipientId  String
  amountCents  Int
  currency     String         @default("sUSD")
  network      SolanaNetwork  @default(DEVNET)
  tokenMint    String?
  walletAddress String
  signature    String?        @unique
  status       TransferStatus @default(QUEUED)
  error        String?
  sentAt       DateTime?
  confirmedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  payoutRun PayoutRun @relation(fields: [payoutRunId], references: [id], onDelete: Cascade)
  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([payoutRunId])
  @@index([recipientId])
  @@index([status])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actor          String
  action         String
  targetType     String
  targetId       String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
}
